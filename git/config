[user]
    name = Leonardo Bevilacqua

[core]
    compression = 9
    whitespace = error
    preloadindex = true 

[advice]
    addEmptyPathspec = false
    pushNonFastForward = false
    statusHints = false

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all

[diff]
    context = 3
    renames = copies
    interHunkContext = 10

[pager]
    diff = diff-so-fancy | $PAGER

[diff-so-fancy]
    markEmptyLines = false

[color "diff"]
    ; meta       = black bold
    frag       = magenta
    context    = white
    whitespace = yellow reverse
    old        = red

[log]
    abbrevCommit = true
    graphColors  = blue,yellow,cyan,magenta,green,red

[color "decorate"]
    HEAD         = red
    branch       = blue
    tag          = yellow
    remoteBranch = magenta

[branch]
    sort = -committerdate

[tag]
    sort = -taggerdate

[color "branch"]
    current  = magenta
    local    = default
    remote   = yellow
    upstream = green
    plain    = blue
